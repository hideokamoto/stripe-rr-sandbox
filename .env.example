# Cloudflare account ID (Workers AI / AI Gateway)
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API token with "Workers AI - Read" permission
CLOUDFLARE_API_TOKEN=

# AI Gateway ID. Required only for calling @cf/-prefixed Workers AI models
# (e.g. gpt-oss-20b) through /ai/v1/chat/completions. A default gateway is
# created automatically on first use in the Cloudflare dashboard.
CLOUDFLARE_AI_GATEWAY_ID=

# Optional: Context7 MCP API key (https://context7.com/dashboard).
# Works without a key too, at a lower rate limit.
CONTEXT7_API_KEY=
