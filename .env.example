# Cloudflare Workers AI
# Account ID: Cloudflare dashboard right sidebar (any zone), or `wrangler whoami`
CLOUDFLARE_ACCOUNT_ID=
# API Token: My Profile > API Tokens > Create Token > "Workers AI" template
# (needs Account > Workers AI > Read permission)
CLOUDFLARE_API_TOKEN=
# Optional: override the Workers AI chat model (defaults to @cf/openai/gpt-oss-120b)
# CHAT_MODEL_ID=@cf/openai/gpt-oss-20b

# Stripe
# Use a restricted key with Products/Prices read+write for the seed script,
# and at least read access for the chat app itself.
STRIPE_SECRET_KEY=
