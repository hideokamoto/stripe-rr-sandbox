# --- Clerk (https://dashboard.clerk.com) ---
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# --- Stripe (test mode, https://dashboard.stripe.com/test) ---
# Prefer a restricted API key (rk_) over a full secret key (sk_)
STRIPE_SECRET_KEY=rk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# From `stripe listen` or the Dashboard webhook endpoint
STRIPE_WEBHOOK_SECRET=whsec_...

# Recurring Price IDs created in the Stripe Dashboard.
# At least one is required; STRIPE_PRICE_YEARLY is optional.
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...

# Public base URL of this app (used for Checkout return_url / invitation redirect)
APP_URL=http://localhost:5173
